---
/**
 * Minimal SVG process/phase diagram — terminal-styled.
 * Horizontal flow of phases: dashed spine, node glyphs, mono labels.
 * Used in case pages to show design method / phases.
 */
interface Phase {
  label: string;
  caption: string;
}
interface Props {
  phases: Phase[];
  title?: string;
}
const { phases, title } = Astro.props;

const VB_W = 960;
const VB_H = 150;
const x0 = 130;          // generous side margin so edge captions don't clip the viewBox
const x1 = VB_W - 130;
const spineY = 66;
const n = phases.length;
const step = n > 1 ? (x1 - x0) / (n - 1) : 0;
const xs = phases.map((_, i) => x0 + i * step);
---

<figure class="pflow">
  {title && <figcaption class="pflow-title">{title}</figcaption>}
  <svg viewBox={`0 0 ${VB_W} ${VB_H}`} role="img"
       aria-label={`Process: ${phases.map((p) => p.label).join(' to ')}`}
       preserveAspectRatio="xMidYMid meet">
    <line x1={x0} y1={spineY} x2={x1} y2={spineY}
          stroke="var(--color-border-bright)" stroke-width="1" stroke-dasharray="3 4" />

    {phases.map((p, i) => (
      <g>
        {i < n - 1 && (
          <text x={xs[i] + step / 2} y={spineY + 4} text-anchor="middle" class="pflow-arrow">&gt;</text>
        )}
        <text x={xs[i]} y={spineY - 26} text-anchor="middle" class="pflow-num">0{i + 1}</text>
        <circle cx={xs[i]} cy={spineY} r="7" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="1.5" />
        <circle cx={xs[i]} cy={spineY} r="2.5" fill="var(--color-accent)" />
        <text x={xs[i]} y={spineY + 34} text-anchor="middle" class="pflow-label">{p.label}</text>
        <text x={xs[i]} y={spineY + 54} text-anchor="middle" class="pflow-caption">{p.caption}</text>
      </g>
    ))}
  </svg>
</figure>

<style>
  .pflow {
    margin: 0 0 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-raised);
    padding: 1rem 0.5rem 0.75rem;
  }
  .pflow-title {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    padding: 0 0.75rem 0.5rem;
  }
  .pflow svg { width: 100%; height: auto; display: block; }
  .pflow-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; fill: var(--color-accent); letter-spacing: 0.1em;
  }
  .pflow-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 17px; font-weight: 600; fill: var(--color-text-bright);
  }
  .pflow-caption {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; fill: var(--color-text-muted);
  }
  .pflow-arrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px; fill: var(--color-border-bright);
  }
</style>
