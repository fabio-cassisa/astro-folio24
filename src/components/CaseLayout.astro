---
import Layout from '@layouts/Layout.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  slug: string;          // e.g. 'studio-75'
  title: string;         // page + heading
  description: string;   // meta
  intro: string[];       // one or more intro paragraphs
  tech: string[];
  live?: string;
  github?: string;
  liveLabel?: string;    // override display of the live url
}
const { slug, title, description, intro, tech, live, github, liveLabel } = Astro.props;
---

<Layout title={`case: ${slug} — dagas`} description={description}>
  <section class="mb-16">
    <a href="/projects" class="inline-block text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mb-6">
      ← ~/projects
    </a>

    <SectionHeader label="case study" />
    <p class="text-xs text-[var(--color-text-muted)] mb-8">
      <span class="text-[var(--color-accent)]">$</span> cat ~/cases/{slug}.md
    </p>

    <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-accent)] mb-3">{title}</h1>
    {intro.map((p) => (
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-2 max-w-2xl">{p}</p>
    ))}

    <div class="flex flex-wrap gap-1.5 mt-4 mb-4">
      {tech.map((t) => <span class="tag">{t}</span>)}
    </div>
    <p class="text-xs mb-12 flex flex-wrap gap-4">
      {live && (
        <a href={live} target="_blank" rel="noopener noreferrer"
           class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
          live → {liveLabel ?? live.replace(/^https?:\/\//, '')}
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer"
           class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
          code → github
        </a>
      )}
    </p>

    <slot />

    <div class="mt-12 pt-6 border-t border-dashed border-[var(--color-border)]">
      <a href="/projects" class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
        ← back to all projects
      </a>
    </div>
  </section>
</Layout>
