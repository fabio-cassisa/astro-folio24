---
import { info } from '@data/info';

const entries = Object.entries(info.stack);

// Each theme is a coordinated PALETTE — a primary (accent) + a harmonious
// secondary (the cyan-keyed slot). Neutrals stay constant.
const swatches = [
  { name: 'green · default', accent: '#4ade80', sec: '#22d3ee', pick: true },
  { name: 'teal', accent: '#2dd4bf', sec: '#38bdf8', pick: true },
  { name: 'amber', accent: '#fbbf24', sec: '#fb923c', pick: true },
  { name: 'rose', accent: '#fb7185', sec: '#f472b6', pick: true },
  { name: 'violet', accent: '#a78bfa', sec: '#818cf8', pick: true },
  { name: 'mono', accent: '#e4e4e7', sec: '#a1a1aa', pick: true },
  { name: 'muted', accent: '#6a6a80', sec: '#6a6a80', pick: false },
  { name: 'border', accent: '#3a3a50', sec: '#3a3a50', pick: false },
];
---

<div class="win-wrap mb-16">
  <section class="terminal-window win">
    <div class="terminal-titlebar win-bar" data-win-bar>
      <button class="win-dot win-dot--red" data-win="reset" data-glyph="×" title="reset" aria-label="reset neofetch"></button>
      <button class="win-dot win-dot--amber" data-win="min" data-glyph="–" title="minimize" aria-label="minimize neofetch"></button>
      <button class="win-dot win-dot--green" data-win="max" data-glyph="+" title="maximize" aria-label="maximize neofetch"></button>
      <span class="ml-2" data-win-title>dagas@web — neofetch</span>
    </div>
    <div class="win-shade">
      <div class="terminal-body win-body text-xs md:text-sm">
        {/* host line + rule */}
        <div class="mb-4">
          <span class="text-[var(--color-accent)] font-semibold">dagas</span><span
            class="text-[var(--color-text-muted)]">@web</span>
          <div class="border-t border-[var(--color-border)] mt-2"></div>
        </div>

        {/* aligned key/value readout */}
        <dl class="neo-table">
          {
            entries.map(([category, items]) => (
              <Fragment>
                <dt class="text-[var(--color-cyan)] font-medium">{category}</dt>
                <dd class="text-[var(--color-text)]">{(items as string[]).join(' · ')}</dd>
              </Fragment>
            ))
          }
        </dl>

        {/* palette blocks — neofetch signature, doubling as a live accent picker */}
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="flex gap-1.5" id="accent-palette">
            {
              swatches.map((s) =>
                s.pick ? (
                  <button
                    type="button"
                    class="accent-swatch h-5 w-5 rounded-sm border border-[var(--color-border)]"
                    style={`background:linear-gradient(135deg, ${s.accent} 0 50%, ${s.sec} 50% 100%)`}
                    data-accent={s.accent}
                    data-sec={s.sec}
                    title={`theme: ${s.name}`}
                    aria-label={`theme the site ${s.name}`}
                  />
                ) : (
                  <span
                    class="h-5 w-5 rounded-sm border border-[var(--color-border)]"
                    style={`background:${s.accent}`}
                  />
                )
              )
            }
          </div>
          <span class="text-[0.65rem] text-[var(--color-text-muted)]">
            ← each chip is a palette · click to theme the site
          </span>
        </div>
      </div>
    </div>
  </section>

  <p class="win-hint" data-win-hint>psst — drag the bar, poke the dots ●●●</p>
</div>

<style>
  .accent-swatch { cursor: pointer; transition: transform 0.12s ease, box-shadow 0.12s ease; }
  .accent-swatch:hover { transform: translateY(-2px); box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 3px var(--color-text-bright); }
  .accent-swatch.is-active { box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 3px var(--color-accent); }
</style>

<script>
  // window drag/controls live in Layout's shared script; this only wires the
  // palette picker (which is neofetch-specific).
  function initAccentPicker() {
    const swatches = document.querySelectorAll<HTMLButtonElement>('.accent-swatch');
    let active = '#4ade80';
    try { active = localStorage.getItem('accent') || '#4ade80'; } catch (e) {}
    swatches.forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.accent === active);
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const a = btn.dataset.accent, sec = btn.dataset.sec || btn.dataset.accent;
        if (!a) return;
        const r = document.documentElement;
        r.style.setProperty('--color-accent', a);
        r.style.setProperty('--color-accent-dim', a + '40');
        r.style.setProperty('--color-cyan', sec!);
        try { localStorage.setItem('accent', a); localStorage.setItem('accent2', sec!); } catch (e) {}
        swatches.forEach((s) => s.classList.toggle('is-active', s === btn));
      });
    });
  }
  document.addEventListener('astro:page-load', initAccentPicker);
  initAccentPicker();
</script>
