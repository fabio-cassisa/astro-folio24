---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Terminal from '@components/Terminal.astro';
import AsciiBackground from '@components/AsciiBackground.astro';
import BootLoader from '@components/BootLoader.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = 'dagas — creative technologist',
  description = 'designer, developer, and everything in between. portfolio of fabio cassisa.',
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://dagas-portfolio.vercel.app').href} />

    <!-- open graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dagas-portfolio.vercel.app/og.png" />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://dagas-portfolio.vercel.app').href} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://dagas-portfolio.vercel.app/og.png" />

    <ClientRouter />

    {/* apply a saved accent before paint — no colour flash */}
    <script is:inline>
      (function () {
        try {
          var a = localStorage.getItem('accent');
          var c = localStorage.getItem('accent2');
          var r = document.documentElement;
          if (a) {
            r.style.setProperty('--color-accent', a);
            r.style.setProperty('--color-accent-dim', a + '40');
          }
          if (c) r.style.setProperty('--color-cyan', c);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="scanlines">
    <BootLoader />
    <AsciiBackground />
    <div class:list={['relative z-10 mx-auto px-6 py-8 md:py-16 pb-20', wide ? 'max-w-5xl' : 'max-w-3xl']}>
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <Terminal />

    <script>
      // re-apply the saved accent after client-side navigations
      function applyAccent() {
        try {
          const a = localStorage.getItem('accent');
          const c = localStorage.getItem('accent2');
          const r = document.documentElement;
          if (a) {
            r.style.setProperty('--color-accent', a);
            r.style.setProperty('--color-accent-dim', a + '40');
          }
          if (c) r.style.setProperty('--color-cyan', c);
        } catch (e) {}
      }
      document.addEventListener('astro:after-swap', applyAccent);
    </script>

    <script>
      // reusable window behaviour: traffic-light controls + drag-float (tilt +
      // title glitch). Any element with `.win` opts in. Shared by neofetch,
      // free-audit, and any future window-like element.
      const WIN_REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const WIN_GLYPHS = '@%#*&$+=<>/\\|?!░▒▓01';
      const winRnd = () => WIN_GLYPHS[(Math.random() * WIN_GLYPHS.length) | 0];

      function initWindows() {
        document.querySelectorAll<HTMLElement>('.win').forEach((win) => {
          if (win.dataset.winBound) return;
          win.dataset.winBound = '1';
          const bar = win.querySelector<HTMLElement>('[data-win-bar]');
          const title = win.querySelector<HTMLElement>('[data-win-title]');
          const hint = win.parentElement?.querySelector<HTMLElement>('.win-hint');
          const titleText = title ? title.textContent || '' : '';
          const dismiss = () => hint && hint.classList.add('is-gone');

          win.querySelectorAll('[data-win="reset"],[data-win="min"],[data-win="max"]').forEach((el) => {
            el.addEventListener('mousedown', (e) => e.stopPropagation());
            el.addEventListener('click', (e) => {
              e.stopPropagation();
              dismiss();
              const a = el.getAttribute('data-win');
              if (a === 'min') { win.classList.remove('is-max'); win.classList.toggle('is-min'); }
              else if (a === 'max') { win.classList.remove('is-min'); win.classList.toggle('is-max'); }
              else { win.classList.remove('is-min', 'is-max'); win.style.transform = ''; }
            });
          });

          if (!bar) return;
          let d = false, sx = 0, sy = 0, ox = 0, oy = 0, lx = 0, tx = 0, ty = 0, gi = 0;
          let baseL = 0, baseT = 0, wW = 0, wH = 0, collRaf = 0;
          const glitch = () => {
            if (title) title.textContent = titleText.split('').map((c) => (c === ' ' ? ' ' : Math.random() < 0.28 ? winRnd() : c)).join('');
          };
          // gentle, bounded "collision": nudge cards the window is dragged over
          const bump = (wr: DOMRect) => {
            if (WIN_REDUCED) return;
            document.querySelectorAll<HTMLElement>('.card-root, .svc-card').forEach((t) => {
              if (t.dataset.hit) return;
              const r = t.getBoundingClientRect();
              const overlap = !(wr.right < r.left || wr.left > r.right || wr.bottom < r.top || wr.top > r.bottom);
              if (overlap) {
                t.dataset.hit = '1';
                t.classList.add('win-hit');
                window.setTimeout(() => t.classList.remove('win-hit'), 420);
                window.setTimeout(() => { delete t.dataset.hit; }, 720);
              }
            });
          };
          bar.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            d = true; sx = e.clientX; sy = e.clientY; lx = e.clientX;
            const m = /translate\(([-0-9.]+)px,\s*([-0-9.]+)px\)/.exec(win.style.transform || '');
            ox = m ? +m[1] : 0; oy = m ? +m[2] : 0; tx = ox; ty = oy;
            const br = win.getBoundingClientRect();
            baseL = br.left - ox; baseT = br.top - oy; wW = br.width; wH = br.height;
            win.classList.add('is-dragging');
            dismiss();
            if (!WIN_REDUCED && title) gi = window.setInterval(glitch, 90);
            e.preventDefault();
          });
          window.addEventListener('mousemove', (e) => {
            if (!d) return;
            tx = ox + e.clientX - sx; ty = oy + e.clientY - sy;
            // clamp so the window stays within the viewport (8px margin)
            const M = 8;
            const minTx = M - baseL, maxTx = window.innerWidth - M - wW - baseL;
            const minTy = M - baseT, maxTy = window.innerHeight - M - wH - baseT;
            if (maxTx > minTx) tx = Math.max(minTx, Math.min(maxTx, tx));
            if (maxTy > minTy) ty = Math.max(minTy, Math.min(maxTy, ty));
            const v = e.clientX - lx; lx = e.clientX;
            const r = WIN_REDUCED ? 0 : Math.max(-8, Math.min(8, v * 0.5));
            win.style.transform = `translate(${tx}px, ${ty}px) rotate(${r}deg)`;
            if (!collRaf) collRaf = requestAnimationFrame(() => { collRaf = 0; bump(win.getBoundingClientRect()); });
          });
          window.addEventListener('mouseup', () => {
            if (!d) return;
            d = false;
            win.classList.remove('is-dragging');
            if (gi) { clearInterval(gi); gi = 0; }
            if (title) title.textContent = titleText;
            win.style.transform = `translate(${tx}px, ${ty}px)`;
          });
          bar.addEventListener('dblclick', () => { win.style.transform = ''; });
        });
      }
      document.addEventListener('astro:page-load', initWindows);
      initWindows();
    </script>
  </body>
</html>
