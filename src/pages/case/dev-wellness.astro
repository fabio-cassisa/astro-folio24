---
import CaseLayout from '@components/CaseLayout.astro';
import ProcessFlow from '@components/ProcessFlow.astro';

const phases = [
  { label: 'Team', caption: '4 contributors' },
  { label: 'Plan', caption: 'shared state model' },
  { label: 'Build', caption: 'react · redux toolkit' },
  { label: 'Ship', caption: 'live dashboard' },
];
---

<CaseLayout
  slug="dev-wellness"
  title="dev-wellness"
  description="case study — a developer wellness dashboard built as a 4-person collaboration: focus timers, breathing exercises, habit and mood tracking."
  intro={[
    'A wellness dashboard for developers — focus timers, breathing exercises, habit tracking, mood logging, weekly stats. Built as a collaborative project: 4 contributors, 200+ commits.',
    'The interesting part was less any single feature and more keeping a shared codebase coherent across a team — a predictable state model and clean component boundaries so four people could build in parallel.',
  ]}
  tech={['react', 'redux toolkit', 'vite']}
  github="https://github.com/fabio-cassisa/dev-wellness"
  live="https://dev-wellness.vercel.app"
  liveLabel="dev-wellness.vercel.app"
>
  <h3 class="text-xs font-semibold text-[var(--color-cyan)] uppercase tracking-widest mb-4">// process</h3>
  <div class="mb-12">
    <ProcessFlow phases={phases} title="four hands, one codebase" />
  </div>

  <h3 class="text-xs font-semibold text-[var(--color-cyan)] uppercase tracking-widest mb-4">// what's in it</h3>
  <ul class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-12 max-w-2xl space-y-2">
    <li><span class="text-[var(--color-accent)] mr-2">→</span>focus timers and guided breathing exercises</li>
    <li><span class="text-[var(--color-accent)] mr-2">→</span>habit tracking with streaks and a weekly stats view</li>
    <li><span class="text-[var(--color-accent)] mr-2">→</span>mood logging with local persistence</li>
    <li><span class="text-[var(--color-accent)] mr-2">→</span>Redux Toolkit for shared state across the team's features</li>
  </ul>

  <h3 class="text-xs font-semibold text-[var(--color-cyan)] uppercase tracking-widest mb-4">// outcome</h3>
  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-2xl">
    A shipped, live product and a genuine lesson in collaborative front-end work —
    branching discipline, review, and a state architecture that let four people
    move without stepping on each other.
  </p>
</CaseLayout>
